# חיבור חד-פעמי ל-Instagram (חשבון עסקי/יוצר של @cross.the.city)
# מדריך: https://developers.facebook.com/docs/instagram-platform/instagram-api-with-instagram-login/get-started
#
# 1. צרו אפליקציה ב-Meta for Developers
# 2. הוסיפו מוצר Instagram API with Instagram Login
# 3. קבלו Access Token עם הרשאות instagram_basic
# 4. הדביקו כאן:
INSTAGRAM_ACCESS_TOKEN=
# אופציונלי — ברירת מחדל: me
# INSTAGRAM_USER_ID=

# חלופה פשוטה (ללא Meta API): widget מ-https://stellaframe.com/widgets/instagram-feed
# הזינו @cross.the.city, העתיקו את מזהה ה-widget (wgt_...) לכאן או ל-siteConfig.stellaFrameWidgetId
STELLAFRAME_WIDGET_ID=
